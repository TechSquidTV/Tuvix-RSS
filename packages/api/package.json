{
  "name": "@tuvixrss/api",
  "version": "0.1.0",
  "type": "module",
  "description": "TuvixRSS tRPC API - Portable TypeScript backend for Docker and Cloudflare Workers",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.node.json watch --env-file=.env --env-file=../../.env src/entries/node.ts",
    "dev:workers": "wrangler dev --persist-to .wrangler/state",
    "build": "tsup",
    "build:tsc": "tsc",
    "start": "node dist/entries/node.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "drizzle-kit migrate",
    "db:migrate:d1": "bash scripts/migrate-d1.sh",
    "db:migrate:d1:local": "mkdir -p migrations && cp drizzle/*.sql migrations/ 2>/dev/null || true && wrangler d1 migrations apply tuvix --local && rm -rf migrations",
    "db:reset": "tsx src/db/reset-local.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "validate:cloudflare": "tsx scripts/validate-cloudflare-config.ts",
    "test:toml-substitution": "bash scripts/test-toml-substitution.sh",
    "predeploy": "pnpm validate:cloudflare && pnpm build",
    "deploy": "pnpm predeploy && bash scripts/deploy.sh",
    "create-admin": "tsx src/cli/create-admin.ts",
    "clear-articles": "tsx src/cli/clear-articles.ts",
    "migrate:public-categories": "tsx src/scripts/migrate-public-categories-to-feeds.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "email:preview": "pnpm exec email dev --dir src/services/email-templates"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.70",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@sentry/cloudflare": "^10.75.0",
    "@sentry/node": "^10.75.0",
    "@trpc/server": "^11.19.0",
    "@tuvixrss/tricorder": "workspace:*",
    "ai": "^7.0.106",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "feedsmith": "^3.0.0",
    "hono": "^4.13.8",
    "ipaddr.js": "2.5.0",
    "node-cron": "^4.6.0",
    "react-email": "^6.9.5",
    "resend": "^6.28.1",
    "sanitize-html": "^2.17.7",
    "superjson": "^2.2.6",
    "undici": "8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
